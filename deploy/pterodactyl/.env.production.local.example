# Copy to /home/container/shared/.env.production.local in the app container.
# Never commit the real file. Percent-encode special characters in URL passwords.
# This Docker DNS name was tested from the NuraHost app container; recheck after any server remap.
DATABASE_URL="postgresql://REPLACE_DB_USER:REPLACE_URL_ENCODED_PASSWORD@461b710f-642a-4ea8-af0a-668edcfa5d6a.pterodactyl_nw:5112/movieflix?schema=public&sslmode=disable"
DIRECT_DATABASE_URL="postgresql://REPLACE_MIGRATION_DB_USER:REPLACE_URL_ENCODED_PASSWORD@461b710f-642a-4ea8-af0a-668edcfa5d6a.pterodactyl_nw:5112/movieflix?schema=public&sslmode=disable"
DATABASE_DRIVER="pg"
ALLOW_INSECURE_POSTGRES="true"
DB_POOL_MAX="4"

NEXT_PUBLIC_APP_URL="https://www.movieflix.site"
NEXT_PUBLIC_SITE_NAME="MovieFlix"
BETTER_AUTH_URL="https://www.movieflix.site"
BETTER_AUTH_SECRET="REPLACE_WITH_UNIQUE_RANDOM_32_PLUS_CHARACTERS"
ORIGIN_GATE_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_32_PLUS_CHARACTER_TOKEN"
ANALYTICS_HMAC_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_32_PLUS_CHARACTER_TOKEN"
REVALIDATION_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_32_PLUS_CHARACTER_TOKEN"
REVALIDATION_BASE_URL="https://www.movieflix.site"
CONTACT_EMAIL="ocrist98@gmail.com"
GOOGLE_SITE_VERIFICATION=""
SEO_INDEXING_ENABLED="false"
IMPORT_EXECUTION_MODE="local"
SITEMAP_CACHE_DIR="/home/container/shared/sitemaps"

# Optional monitoring; leave empty if unused.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
