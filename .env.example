# Database Connection
# If using PgBouncer or Prisma Accelerate, DATABASE_URL is your pooled connection (e.g. ?pgbouncer=true).
# DIRECT_DATABASE_URL is your direct database connection used for running migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/trailer-movie?schema=public&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/trailer-movie?schema=public"

# Better Auth
BETTER_AUTH_SECRET="super-secret-better-auth-key-replace-me"
BETTER_AUTH_URL="http://localhost:3000"

# External APIs
TMDB_API_KEY="your-tmdb-api-key"
TMDB_ACCESS_TOKEN="your-tmdb-access-token"
TMDB_BASE_URL="https://api.themoviedb.org/3"

# Initial Admin Account
ADMIN_EMAIL="admin@admin.com"
ADMIN_PASSWORD="password123"
