# Database Connection
DATABASE_URL="postgresql://movieflix_app:replace-me@postgres.internal:5432/movieflix?schema=public&sslmode=verify-full"
DIRECT_DATABASE_URL="postgresql://movieflix_owner:replace-me@postgres.internal:5432/movieflix?schema=public&sslmode=verify-full"
DATABASE_DRIVER="pg"
# Development/emergency only. Production requires TLS, a private route, or strict IP allowlisting.
ALLOW_INSECURE_POSTGRES="false"
DB_POOL_MAX="4"

# Better Auth
BETTER_AUTH_SECRET="super-secret-better-auth-key-replace-me"
BETTER_AUTH_URL="https://www.movieflix.site"

# External APIs
TMDB_API_KEY="your-tmdb-api-key"
TMDB_ACCESS_TOKEN="your-tmdb-access-token"
TMDB_BASE_URL="https://api.themoviedb.org/3"

# Public SEO (keep indexing disabled until the canonical domain is live and verified)
NEXT_PUBLIC_APP_URL="https://www.movieflix.site"
GOOGLE_SITE_VERIFICATION="your-google-site-verification-token"
NEXT_PUBLIC_TWITTER_HANDLE=""
CONTACT_EMAIL=""
SEO_INDEXING_ENABLED="false"
ANALYTICS_HMAC_SECRET="replace-with-at-least-32-random-characters"
REVALIDATION_SECRET="replace-with-a-separate-32-character-secret"
REVALIDATION_BASE_URL="https://www.movieflix.site"
APP_RELEASE_SHA="replace-with-git-commit-sha"
SITEMAP_CACHE_DIR="/home/container/shared/sitemaps"

# Persistent import worker
IMPORT_EXECUTION_MODE="local"
IMPORT_DB_POOL_MAX="4"
IMPORT_HEALTHCHECK_URL="https://www.movieflix.site/api/ready"
IMPORT_HEALTHCHECK_MAX_MS="2500"
# Enable only after running the quality backfill dry-run report.
IMPORT_QUALITY_BACKFILL_ENABLED="false"
# Measured locally: 60 jobs completed in 52 seconds versus 6 jobs in 27 seconds (~5.2x throughput).
# Lower concurrency here if your database pool or TMDB starts returning 429/timeouts.
IMPORT_MOVIE_BATCH_SIZE="20"
IMPORT_PERSON_BATCH_SIZE="40"
IMPORT_MOVIE_CONCURRENCY="4"
IMPORT_PERSON_CONCURRENCY="8"

# Optional Sentry source-map upload. Leave all empty to disable build integration.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.05"
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Initial Admin Account
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password"
