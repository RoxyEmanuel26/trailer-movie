# Database Connection
# If using PgBouncer or Prisma Accelerate, DATABASE_URL is your pooled connection (e.g. ?pgbouncer=true).
# DIRECT_DATABASE_URL is your direct database connection used for running migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/trailer-movie?schema=public&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/trailer-movie?schema=public"
# Keep DATABASE_DRIVER=neon until the PostgreSQL 17 TLS migration has been verified.
# Cutover example: DATABASE_DRIVER=pg and sslmode=verify-full on both URLs.
DATABASE_DRIVER="neon"
# Temporary fallback only when the database host cannot support TLS. This exposes credentials and data in transit.
ALLOW_INSECURE_POSTGRES="false"
# Cloudflare Pages: 2; local import process: 12. Do not share one pool across deployments.
DB_POOL_MAX="1"

# Better Auth
BETTER_AUTH_SECRET="super-secret-better-auth-key-replace-me"
BETTER_AUTH_URL="http://localhost:3000"

# External APIs
TMDB_API_KEY="your-tmdb-api-key"
TMDB_ACCESS_TOKEN="your-tmdb-access-token"
TMDB_BASE_URL="https://api.themoviedb.org/3"

# Public SEO (keep indexing disabled until the canonical domain is live and verified)
NEXT_PUBLIC_APP_URL="https://www.movieflix.site"
GOOGLE_SITE_VERIFICATION="your-google-site-verification-token"
NEXT_PUBLIC_TWITTER_HANDLE=""
CONTACT_EMAIL=""
SEO_INDEXING_ENABLED="false"
ANALYTICS_HMAC_SECRET="replace-with-at-least-32-random-characters"
REVALIDATION_SECRET="replace-with-a-separate-32-character-secret"
REVALIDATION_BASE_URL="http://localhost:3000"

# Persistent import worker
# Switch to local only at cutover. The Cloudflare cron endpoint then refuses processing.
IMPORT_EXECUTION_MODE="remote"
CRON_SECRET="replace-with-a-long-random-secret"
PAGES_BASE_URL="https://your-project.pages.dev"
# Enable only after running the quality backfill dry-run report.
IMPORT_QUALITY_BACKFILL_ENABLED="false"
# Measured locally: 60 jobs completed in 52 seconds versus 6 jobs in 27 seconds (~5.2x throughput).
# Lower concurrency here if your database pool or TMDB starts returning 429/timeouts.
IMPORT_MOVIE_BATCH_SIZE="20"
IMPORT_PERSON_BATCH_SIZE="40"
IMPORT_MOVIE_CONCURRENCY="10"
IMPORT_PERSON_CONCURRENCY="20"

# Initial Admin Account
ADMIN_EMAIL="admin@admin.com"
ADMIN_PASSWORD="password123"
