{
  "name": "movieflix",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:imports": "tsx --test tests/import-pipeline.test.ts",
    "test:seo": "tsx --test tests/seo-foundation.test.ts tests/homepage-intelligence.test.ts tests/production-hardening.test.ts",
    "import:bulk": "npx tsx --env-file=.env scripts/bulk-discover.ts",
    "import:process-local": "tsx --env-file=.env scripts/process-import-queue.ts",
    "db:verify-target": "tsx --env-file=.env scripts/verify-postgres-target.ts",
    "db:compare-migration": "tsx --env-file=.env scripts/compare-migration.ts",
    "enrich:backfill": "npx tsx scripts/backfill-enriched-data.ts",
    "db:backup": "npx tsx scripts/download-full-database.ts",
    "db:audit": "npx tsx scripts/audit-database-fields.ts",
    "seo:seed-genres": "npx tsx --env-file=.env scripts/seed-genre-descriptions.ts",
    "seo:warm-sitemaps": "tsx --env-file=.env scripts/warm-sitemap-cache.ts",
    "import:verify": "tsx --env-file=.env scripts/verify-import-pipeline.ts",
    "import:quality:dry-run": "npx tsx --env-file=.env scripts/backfill-import-quality.ts --dry-run",
    "import:quality:apply": "npx tsx --env-file=.env scripts/backfill-import-quality.ts --apply",
    "release:prepare": "bash deploy/pterodactyl/prepare-release.sh",
    "release:start": "bash deploy/pterodactyl/start-release.sh",
    "db:backup:production": "powershell -ExecutionPolicy Bypass -File scripts/backup-production.ps1",
    "db:restore-test": "powershell -ExecutionPolicy Bypass -File scripts/test-backup-restore.ps1"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-neon": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/instrumentation": "7.10.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^10.69.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/ws": "^8.18.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/otel": "^2.1.3",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "duck-duck-scrape": "^2.2.7",
    "isomorphic-dompurify": "^3.21.0",
    "lucide-react": "^1.28.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "openai": "^7.8.0",
    "pg": "8.23.0",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-youtube": "^10.1.0",
    "recharts": "^3.10.1",
    "slugify": "^1.6.9",
    "sharp": "0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "use-debounce": "^10.1.1",
    "ws": "8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
